# --- Server ---
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# --- Secrets (generate with: openssl rand -hex 64) ---
# NEVER reuse these values, NEVER commit the real .env file
JWT_SECRET=replace_with_a_64_byte_random_hex_string
QR_TOKEN_SECRET=replace_with_a_different_64_byte_random_hex_string

# --- Token lifetimes ---
LOGIN_TOKEN_TTL=8h

# --- Bootstrap admin (created on first run only, then disable) ---
BOOTSTRAP_ADMIN_EMAIL=admin@yourfest.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisImmediately!123
BOOTSTRAP_ADMIN_NAME=Fest Admin

# --- SMTP (no-reply mailer) ---
# Use a transactional email provider (SES, SendGrid, Postmark, Mailgun) in production.
# Raw Gmail SMTP is fine for testing only.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey_or_username
SMTP_PASS=your_smtp_password
MAIL_FROM_NAME=Techfest 2026
MAIL_FROM_ADDRESS=no-reply@yourfest.com

# --- Database ---
DB_PATH=./data/techfest.db
